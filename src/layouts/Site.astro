---
import Header from '../components/Header.astro';
import '../styles/global.css';
const { title = 'Lehel Babos', description = 'Toronto based Product Designer. I help teams solve problems, ship products and scale their design teams and practice.', home = false, protectedPage = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {protectedPage && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
  </head>
  <body>
    <Header home={home} />
    <main id="page"><slot /></main>
    <footer class="site-footer"><p>Copyright © 2022 Lehel Babos</p></footer>
  </body>
</html>
