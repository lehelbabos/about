---
import Header from '../components/Header.astro';
import '../styles/global.css';
import '../styles/portfolio-grid.css';
import bodyFont from '../fonts/ibm-plex-sans-variable-normal.woff2?url';
import headingFont from '../fonts/ibm-plex-serif-variable-normal.woff2?url';
const { title = 'Lehel Babos', description = 'Toronto based Product Designer. I help teams solve problems, ship products and scale design.', home = false, about = false, protectedPage = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {protectedPage && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Apply a theme saved by the header toggle before first paint; otherwise the OS setting decides.
      try { const theme = localStorage.getItem('theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
    {protectedPage && <script is:inline>
      // Prevent the password form flashing when this browser already has access.
      try {
        if (Object.keys(localStorage).some(name => {
          if (!name.startsWith('portfolio-access-v1:')) return false;
          try { const saved = JSON.parse(localStorage.getItem(name)); return typeof saved?.key === 'string' && saved.expiresAt > Date.now(); } catch { return false; }
        })) document.documentElement.classList.add('checking-study-access');
      } catch {}
    </script>}
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="preload" as="font" href={bodyFont} type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" href={headingFont} type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <Header home={home} about={about} />
    <main id="page"><slot /></main>
    <footer class="site-footer"><p>Copyright © <span data-copyright-year>{new Date().getFullYear()}</span> Lehel Babos</p></footer>
  </body>
</html>
<script>
  function updateCopyrightYear() {
    const year = document.querySelector('[data-copyright-year]');
    if (year) year.textContent = String(new Date().getFullYear());
  }
  updateCopyrightYear();
  window.addEventListener('pageshow', updateCopyrightYear);
</script>

