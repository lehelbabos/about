---
import social from '../data/social.json';
import Icon from './Icon.astro';
const { variant = 'header' } = Astro.props;
const profile = variant === 'profile';
---
<div class:list={['social-links', variant]} aria-label="Social links">
  {social.map(link => <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer"><Icon name={link.icon.slice(1)} viewBox={profile ? '0 0 64 64' : '23 23 64 64'} size={profile ? 64 : 110} /></a>)}
</div>
<style>
  .social-links { display: flex; align-items: center; gap: 20px; }
  .header { gap: 1.5vw; }
  .mobile { gap: 24px; }
  a { display: block; width: 20px; height: 20px; color: #303030; }
  a :global(svg) { display: block; width: 100%; height: 100%; fill: currentColor; }
  .profile { gap: 8px; }
  .profile a { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border: 2px solid #323232; border-radius: 15%; color: #323232; }
  .profile :global(svg) { width: 32px; height: 32px; flex-shrink: 0; }
  @media (max-width: 767px) { .header { display: none; } }
</style>
