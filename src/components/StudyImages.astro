<dialog class="story-image-dialog" aria-label="Full-size case study image">
  <button class="close-story-image" aria-label="Close image">×</button>
  <img alt="" />
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.story-image-dialog')!;
  const image = dialog.querySelector('img')!;
  const close = dialog.querySelector<HTMLButtonElement>('button')!;
  let opener: HTMLElement | null = null;
  document.querySelectorAll<HTMLAnchorElement>('.story-body figure a[href]').forEach(link => {
    const thumbnail = link.querySelector('img');
    if (!thumbnail) return;
    link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = link;
      image.src = link.href;
      image.alt = thumbnail.alt;
      dialog.showModal();
      close.focus();
    });
  });
  close.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { image.removeAttribute('src'); opener?.focus(); });
</script>
