---
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = project.locked || project.local ? `${base}${project.href}` : project.href;
---
<a class={`work_item ${project.id}`} href={href} target="_blank" rel="noopener noreferrer" style={`background-image:url('${base}images/${project.image}')`}>
  <span class="item_cta"><svg class="launch-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z"/></svg> Open case study</span>
  <div class="item_meta">
    <span class="item_title">{project.title}</span>
    <span class="item_product">{project.product}</span>
    <ul class="item_tags">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    {project.locked && <span class="locked"><svg viewBox="0 0 24 24" aria-label="Password protected" role="img"><path d="M18 8h-1V6A5 5 0 0 0 7 6v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2m-6 9a2 2 0 1 1 0-4 2 2 0 0 1 0 4M9 8V6a3 3 0 0 1 6 0v2z"/></svg></span>}
  </div>
</a>
