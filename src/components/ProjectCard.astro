---
import PortfolioImage from './PortfolioImage.astro';
import Icon from './Icon.astro';
const { project, priority = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = project.locked || project.local ? `${base}${project.href}` : project.href;
---
<a class={`work_item ${project.id}`} href={href} data-astro-prefetch="hover">
  <PortfolioImage name={project.image} alt="" class="card-image" priority={priority} sizes="(max-width: 767px) 88vw, (max-width: 1600px) 48vw, 800px" />
  <span class="item_cta"><Icon name="launch-icon" class="launch-icon" /> Open case study</span>
  <div class="item_meta">
    <span class="item_title">{project.title}</span>
    <span class="item_product">{project.product}</span>
    <ul class="item_tags">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    {project.locked && <span class="locked" role="img" aria-label="Password protected"><Icon name="lock-icon" /></span>}
  </div>
</a>
