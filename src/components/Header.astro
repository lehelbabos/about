---
import SocialLinks from './SocialLinks.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import logo from '../../public/images/logo.png';
const base = import.meta.env.BASE_URL;
const { home = false, about = false } = Astro.props;
---
<header class="site-header">
  <a class="logo" href={base} aria-label="Lehel Babos — Work"><Image src={logo} alt="Lehel Babos" width={64} height={64} format="png" loading="eager" /></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <a class:list={[{ active: home }]} href={base} aria-current={home ? 'page' : undefined} data-astro-prefetch="hover">Work</a>
    <a class:list={[{ active: about }]} href={`${base}about/`} aria-current={about ? 'page' : undefined} data-astro-prefetch="hover">About</a>
  </nav>
  <div class="header-actions">
    <SocialLinks />
    <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode"><span class="knob"><Icon name="sun-icon" class="sun" /><Icon name="moon-icon" class="moon" /></span></button>
  </div>
  <button class="menu-toggle" aria-label="Open Menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile navigation"><a href={base} aria-current={home ? 'page' : undefined} data-astro-prefetch="hover">Work</a><a href={`${base}about/`} aria-current={about ? 'page' : undefined} data-astro-prefetch="hover">About</a></nav>
    <SocialLinks variant="mobile" />
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const close = () => { if (toggle && menu) { toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'Open Menu'); menu.hidden = true; document.body.style.overflow = ''; } };
  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close Menu' : 'Open Menu');
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu?.hidden) { close(); toggle?.focus(); } });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
  matchMedia('(min-width: 768px)').addEventListener('change', close);

  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const prefersDark = matchMedia('(prefers-color-scheme: dark)');
  let themeFadeTimer: ReturnType<typeof setTimeout> | undefined;
  const currentTheme = () => document.documentElement.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');
  const labelThemeToggle = () => themeToggle?.setAttribute('aria-checked', String(currentTheme() === 'dark'));
  themeToggle?.addEventListener('click', () => {
    const theme = currentTheme() === 'dark' ? 'light' : 'dark';
    const root = document.documentElement;
    const duration = 200 / (parseFloat(getComputedStyle(root).getPropertyValue('--motion-speed')) || 1);
    root.classList.add('theme-transition');
    clearTimeout(themeFadeTimer);
    themeFadeTimer = setTimeout(() => root.classList.remove('theme-transition'), duration + 50);
    root.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch {}
    labelThemeToggle();
  });
  prefersDark.addEventListener('change', labelThemeToggle);
  labelThemeToggle();
</script>
<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; position: relative; padding: 1.8vw 2vw; background: var(--bg); z-index: 20; line-height: 1; }
  .logo { display: block; line-height: 0; }
  .logo :global(img) { display: block; width: 32px; height: 32px; filter: var(--logo-filter); }
  .desktop-nav { position: absolute; left: 50%; transform: translateX(-50%); display: flex; gap: 20px; line-height: 2; }
  .desktop-nav a { color: var(--text); text-decoration: none; }
  .desktop-nav a.active { text-decoration: underline; text-underline-offset: .55em; }
  .header-actions { display: flex; align-items: center; gap: 1.5vw; }
  /* A small switch, deliberately unlike the social icons: the knob sits left with a sun
     in light mode and slides right with a moon in dark mode. */
  .theme-toggle { position: relative; display: block; width: 46px; height: 24px; margin-left: 8px; padding: 0; border: 1px solid var(--border); border-radius: 12px; background: var(--switch-track); box-shadow: inset 0 1px 2px rgb(0 0 0 / .11); cursor: pointer; }
  .knob { position: absolute; top: 2px; left: 2px; display: grid; place-items: center; width: 18px; height: 18px; border: 1px solid var(--border); border-radius: 50%; background: var(--switch-knob); box-shadow: 0 1px 3px rgb(0 0 0 / .3), 0 0 0 .5px rgb(0 0 0 / .08); transition: transform calc(200ms / var(--motion-speed)) ease; }
  .knob :global(svg) { grid-area: 1 / 1; width: 12px; height: 12px; fill: var(--switch-icon); }
  .knob :global(.moon) { display: none; }
  :global(:root[data-theme="dark"]) .knob { transform: translateX(22px); }
  :global(:root[data-theme="dark"]) .knob :global(.sun) { display: none; }
  :global(:root[data-theme="dark"]) .knob :global(.moon) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .knob { transform: translateX(22px); }
    :global(:root:not([data-theme="light"])) .knob :global(.sun) { display: none; }
    :global(:root:not([data-theme="light"])) .knob :global(.moon) { display: block; }
  }
  .menu-toggle { display: none; border: 0; background: none; cursor: pointer; padding: 0; }
  .mobile-menu[hidden] { display: none; }
  @media (min-width: 768px) { .site-header { min-height: calc(3.6vw + 2 * (16px + .2 * var(--type-unit))); } }
  @media (max-width: 767px) {
    .site-header { height: calc(32px + 2 * 6vw + 5px); padding: 6vw; justify-content: center; }
    .desktop-nav { display: none; }
    .logo :global(img) { width: 32px; height: 32px; }
    .header-actions { position: absolute; right: 6vw; }
    .menu-toggle { position: absolute; left: 6vw; display: flex; flex-direction: column; justify-content: space-between; width: 30px; height: 23px; z-index: 2; }
    .menu-toggle span { height: 3px; width: 100%; background: var(--text); transition: transform calc(200ms / var(--motion-speed)); }
    .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(10px) rotate(45deg); }
    .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-10px) rotate(-45deg); }
    .mobile-menu { position: fixed; inset: calc(32px + 2 * 6vw + 5px) 0 0; background: var(--bg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 60px; }
    .mobile-menu nav { display: flex; flex-direction: column; text-align: center; gap: 30px; font-size: 32px; }
    .mobile-menu nav a { color: inherit; text-decoration: none; }
  }
</style>
